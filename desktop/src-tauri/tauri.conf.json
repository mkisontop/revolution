{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revolution",
  "version": "0.1.0",
  "identifier": "com.mk.revolution",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "url": "index.html",
        "title": "Rev",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "width": 280,
        "height": 340,
        "resizable": false,
        "visible": true
      },
      {
        "label": "panel",
        "url": "panel.html",
        "title": "Revolution — panel",
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false,
        "width": 480,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
