{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revolution",
  "version": "0.2.0",
  "identifier": "com.mk.revolution",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "url": "index.html",
        "title": "Rev",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "width": 280,
        "height": 340,
        "resizable": false,
        "visible": true
      },
      {
        "label": "panel",
        "url": "panel.html",
        "title": "Revolution",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false,
        "width": 500,
        "height": 760,
        "minWidth": 430,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Rev — the AI friend who watches your game",
    "longDescription": "Revolution is an on-screen AI gaming companion: hold a key, talk about what's on screen, and hear a friend answer. Bring your own model API key.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
